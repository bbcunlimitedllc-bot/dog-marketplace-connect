# Copy this file to `.env` and fill in the values. NEVER commit a real key.
#   cp .env.example .env

# Your Stripe TEST secret key (starts with sk_test_).
# Get one at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=

# Webhook signing secret for the /api/webhooks endpoint (starts with whsec_).
# The `stripe listen` command in the README prints one when it starts.
STRIPE_WEBHOOK_SECRET=

# Public URL of this app. Used for onboarding refresh/return URLs and the
# Checkout success URL. localhost is fine for local testing; use your
# https:// tunnel or deployed URL when going further.
APP_URL=http://localhost:4242

# Dog Marketplace commission on each puppy sale or transport booking, in percent (default 10).
# Example: a $1,200 puppy with 10% => $120.00 application fee to the platform,
# $1,080.00 transferred to the breeder.
APPLICATION_FEE_PERCENT=10

# Port this app listens on.
PORT=4242
